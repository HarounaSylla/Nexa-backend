ENVIRONMENT=local

# Database (Compose publishes Postgres on host port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nexa

# Redis (Compose publishes Redis on host port 6380)
REDIS_URL=redis://localhost:6380/0

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-terra

# Embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_IMAGE_MODEL=voyage-multimodal-3.5
# Image-match cosine-distance placeholders; retune on real photos.
IMAGE_MATCH_STRONG_DISTANCE=0.20
IMAGE_MATCH_POSSIBLE_DISTANCE=0.45
IMAGE_MATCH_MIN_MARGIN=0.08
MAX_IMAGE_ANALYSES_PER_PHONE_PER_DAY=10
RAG_MAX_DISTANCE=0.50

# WhatsApp Cloud API — leave blank until access is approved
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret from Meta → App settings → Basic. Required for
# X-Hub-Signature-256 checks; leave blank only in local dev.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# TikTok — leave blank until access is approved
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_ACCESS_TOKEN=

# Clerk (dashboard auth). Issuer is the Frontend API URL from the Clerk
# dashboard (e.g. https://verb-noun-12.clerk.accounts.dev). JWKS is
# {CLERK_ISSUER}/.well-known/jwks.json — no secret key is required to
# verify session JWTs. CLERK_AUTHORIZED_PARTIES is a comma-separated
# list of frontend origins (azp + CORS).
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Private inbound WhatsApp images (payment proofs). Never under /static.
MEDIA_DIR=./data/private_media
# Delete inbound image files this many days after reception, once the order
# is paid/cancelled or the photo is unmatched. Rows stay; only the file goes.
PAYMENT_PROOF_RETENTION_DAYS=90

# Country calling code without '+'. 9-digit local mobiles starting with 7
# (e.g. 771234567) are stored as +{code}{digits}. WhatsApp already sends
# the country code (221…).
DEFAULT_COUNTRY_CALLING_CODE=221

